{
  "name": "uade-mcp",
  "version": "0.1.0",
  "description": "MCP no oficial y de solo lectura para alumnos de UADE: WebCampus, inscripciones, apuntes e información oficial. Corre local, sin telemetría.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "revisar": "node scripts/revisar.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.1",
    "cheerio": "1.2.0",
    "fflate": "0.8.3",
    "playwright-core": "1.64.1",
    "read-excel-file": "9.3.12",
    "unpdf": "1.9.0",
    "word-extractor": "1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/word-extractor": "1.0.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "write-excel-file": "4.1.1"
  },
  "private": true,
  "bin": {
    "uade-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ]
}
